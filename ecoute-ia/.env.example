# Clé API Gemini (https://aistudio.google.com/apikey).
# Facultative : sans clé, l'app fonctionne en mode démo local (réponses
# réflectives génériques) au lieu d'appeler l'API Gemini.
VITE_GEMINI_API_KEY=

# Modèle Gemini à utiliser (ajuster selon les modèles disponibles sur votre compte).
VITE_GEMINI_MODEL=gemini-2.5-flash
